{
  "name": "@osrs-llm-helper/backend",
  "version": "0.0.0",
  "private": true,
  "description": "Bun + Hono backend: chat orchestration over OpenRouter, Stripe billing, RuneLite WebSocket bridge.",
  "type": "module",
  "main": "./src/server.ts",
  "scripts": {
    "dev": "bun --hot src/server.ts",
    "start": "bun run src/server.ts",
    "build": "bun build src/server.ts --target=bun --outdir=dist",
    "test": "bun test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.3",
    "@hono/zod-validator": "^0.8.0",
    "@osrs-llm-helper/shared-types": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.26",
    "nanoid": "^5.1.15",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@osrs-llm-helper/tooling": "workspace:*",
    "@types/bun": "^1.1.14",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.1.3",
    "typescript": "^5.7.2"
  }
}
