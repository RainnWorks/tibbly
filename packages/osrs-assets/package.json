{
  "name": "@osrs-llm-helper/osrs-assets",
  "version": "0.0.0",
  "private": true,
  "description": "License-cleared OSRS-themed visual assets for the marketing site and dashboard.",
  "type": "module",
  "main": "./src/index.ts",
