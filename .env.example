# OSRS LLM Helper — environment variables
# Copy this file to .env and fill in real values. .env is gitignored.

# --- Database -------------------------------------------------------------
# PGLite local dev URL or Postgres connection string for prod (e.g. Neon).
DATABASE_URL=postgres://user:password@localhost:5432/osrs_llm_helper

# --- LLM provider ---------------------------------------------------------
# Obtain from https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-PLACEHOLDER_OBTAIN_FROM_OPENROUTER_DASHBOARD

# --- Stripe billing -------------------------------------------------------
# Live or test secret key from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_PLACEHOLDER
# Webhook signing secret from https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_PLACEHOLDER

# --- Backend runtime ------------------------------------------------------
PORT=3000
